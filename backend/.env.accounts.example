# Copy values into your process environment or use uvicorn --env-file with python-dotenv installed.
# Never commit real keys. For emulator development only:
WAFERAI_AUTH_PUBLIC_URL=http://10.0.2.2:8010
WAFERAI_AUTH_DEV_OUTBOX=1

# Production: HTTPS public origin, DEV_OUTBOX=0, configure real delivery transports.
WAFERAI_SMTP_HOST=
WAFERAI_SMTP_PORT=465
WAFERAI_SMTP_FROM=
WAFERAI_SMTP_USER=
WAFERAI_SMTP_PASSWORD=

# HTTPS delivery adapter owned by you. POST {phone,code,purpose,expires_in}; return {accepted:true}.
# Adapt your Aliyun/Tencent/Twilio SMS provider server-side, never in the APK.
WAFERAI_SMS_URL=
WAFERAI_SMS_TOKEN=

# Website/server OAuth apps with their approved callback domains.
# WeChat uses the website QR authorization flow, not a native WeChat SDK.
WAFERAI_WECHAT_ID=
WAFERAI_WECHAT_SECRET=
WAFERAI_QQ_ID=
WAFERAI_QQ_SECRET=
WAFERAI_FACEBOOK_ID=
WAFERAI_FACEBOOK_SECRET=
# Telegram: BotFather Login Widget Client ID / Secret; configure RS256 and allowed callback URL.
WAFERAI_TELEGRAM_ID=
WAFERAI_TELEGRAM_SECRET=
